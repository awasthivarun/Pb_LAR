elec-ex-corr gga
kpoint-folding 4 4 1
elec-n-bands 0
elec-smearing Fermi 0.001

van-der-waals D3
elec-cutoff 20 100
electronic-minimize nIterations 100 energyDiffThreshold 1e-07
spintype no-spin
core-overlap-check none
symmetries automatic
fluid LinearPCM
pcm-variant CANDLE
fluid-solvent H2O
fluid-cation Na+ 0.5
fluid-anion F- 0.5
band-projection-params yes no
dump Ionic Ecomponents EigStats Forces
dump Ionic ElecDensity Dtot
dump Ionic BoundCharge VfluidTot FluidDensity

pseudos GBRV_v1.5
lattice-type slab
optimizer FIRE
opt-alpha 70
max_steps 400
fmax 0.01
